		"devdoc": {
			"details": "Entry-point contract for interacting with ConstantProductAMM pools. The Router adds three capabilities the raw pool doesn't have: 1. **Deadline** — transactions that sit in the mempool too long revert,    protecting users from stale price execution (sandwich / front-running). 2. **Multi-hop swaps** — swap A→B→C in a single transaction by chaining    pools. The router holds no funds; tokens flow pool-to-pool via transferFrom. 3. **Liquidity helpers** — add/remove liquidity with deadline protection and    a minimum LP token guarantee. This mirrors the role of the Uniswap V2 Router02 contract: users never call pools directly — they call the router, which enforces safety invariants.",
			"kind": "dev",
			"methods": {
				"addLiquidity(address,uint256,uint256,uint256,address,uint256)": {
					"details": "Add liquidity to a pool with a deadline and minimum LP token guarantee."
				},
				"getAmountsOut(address[],address[],uint256)": {
					"details": "Compute the expected output for a multi-hop path without executing.      Useful for UI price display and slippage calculation."
				},
				"removeLiquidity(address,uint256,uint256,uint256,address,uint256)": {
					"details": "Remove liquidity with deadline protection."
				},
				"swapExactTokensForTokens(address,address,uint256,uint256,address,uint256)": {
					"details": "Swap an exact amount of tokenIn for as many tokenOut as possible,      enforcing a minimum output (slippage guard) and a deadline.",
					"params": {
						"amountIn": "Exact amount to sell",
						"amountOutMin": "Minimum output; reverts if pool gives less",
						"deadline": "Unix timestamp after which the tx reverts",
						"pool": "The AMM pool to use",
						"to": "Recipient of the output tokens",
						"tokenIn": "Token being sold"
					}
				},
				"swapExactTokensForTokensMultiHop(address[],address[],uint256,uint256,address,uint256)": {
					"details": "Swap through a sequence of pools in a single transaction.      path = [tokenA, tokenB, tokenC]      pools = [poolAB, poolBC] The router pulls tokenA from the sender, swaps A→B in poolAB, then B→C in poolBC, and delivers tokenC to the recipient. Intermediate tokens never leave the router.",
					"params": {
						"amountIn": "Amount of path[0] to sell",
						"amountOutMin": "Minimum amount of path[last] to receive",
						"deadline": "Expiry timestamp",
						"path": "Ordered list of token addresses",
						"pools": "Ordered list of AMM pools (length = path.length - 1)",
						"to": "Recipient of output tokens"
					}
				}
			},
